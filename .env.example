# ==============================================================================
# Home Server Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and modify for your local system.
# Keep the '.env' file ignored in git to prevent credential leakage.

# ------------------------------------------------------------------------------
# Docker Compose Orchestration
# ------------------------------------------------------------------------------
# List of compose files to merge. Order matters.
# On macOS/Linux, paths are separated by colons (:).
COMPOSE_FILE=docker-compose.yml:compose/jellyfin.yml:compose/homeassistant.yml
COMPOSE_PATH_SEPARATOR=:

# ------------------------------------------------------------------------------
# Global Settings
# ------------------------------------------------------------------------------
# Timezone (e.g., America/New_York, Europe/London, Asia/Kolkata)
TZ=America/New_York

# Linux/UNIX permissions mapping (Run `id -u` and `id -g` in macOS terminal)
# Typical macOS first user is 501, group staff is 20.
PUID=501
PGID=20

# ------------------------------------------------------------------------------
# System Storage Paths
# ------------------------------------------------------------------------------
# External drive path for persistent application configs (Do not use internal SSD)
DOCKER_DIR=/Volumes/drive001/docker

# External drive path for media libraries
MEDIA_DIR=/Volumes/drive001/media

# Backup destination path
BACKUP_DIR=/Users/server/github/home/backups

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
JELLYFIN_PORT=8096
HOMEASSISTANT_PORT=8123

# ------------------------------------------------------------------------------
# Service Versions (Optional Pinning)
# ------------------------------------------------------------------------------
JELLYFIN_VERSION=10.9.8
HOMEASSISTANT_VERSION=2024.7.2
