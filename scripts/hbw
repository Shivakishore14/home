#!/usr/bin/env bash
# Run the Bitwarden CLI against the *homelab* account profile
# (~/.config/bitwarden-homelab), never your personal vault.
#   scripts/hbw login you+homelab@example.com
#   scripts/hbw status | logout | lock
set -euo pipefail
# shellcheck source=lib/bitwarden.sh
. "$(cd "$(dirname "$0")" && pwd)/lib/bitwarden.sh"
bw_installed || { echo "Bitwarden CLI (bw) not installed" >&2; exit 1; }
exec bw "$@"
